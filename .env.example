# ---------------------------------------------------------------------------
# SatarkAI — copy to .env and fill in. .env is gitignored; never commit secrets.
# ---------------------------------------------------------------------------

# PostgreSQL. Local dev default assumes a homebrew postgres on 5432.
DATABASE_URL="postgresql://USER@localhost:5432/satarkai?schema=public"

# Session signing key for the httpOnly auth cookie.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 8h — a working shift for an officer).
SESSION_MAX_AGE="28800"

# Redis — Phase 5 live counters / queue state. Optional; the app runs without it.
REDIS_URL="redis://localhost:6379"

# ML service (Phase 3). `rules` makes the app run with zero ML setup.
#   rules  = deterministic detectors only, no Python service needed
#   ml     = call the FastAPI service, fall back to rules if it is unreachable
ML_MODE="rules"
ML_SERVICE_URL="http://localhost:8000"

# Notifications (Phase 5). `console` prints instead of sending — demo-safe.
NOTIFY_MODE="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="satarkai@example.gov.in"

# Seed: password given to every demo account. Dev/demo only.
SEED_PASSWORD="satark@2026"
